# Copy to .env and fill in. Only needed for the OPTIONAL llm transcript generator and for kit/HF Jobs.

# --- Hugging Face (kit / HF Jobs / pushing the fine-tune). Use a fine-grained token with WRITE scope. ---
HF_TOKEN=

# --- Weights & Biases (kit observability) ---
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=kaigi-cs-asr

# --- OPTIONAL: LLM transcript generator (scripts/01 --use-llm). OpenAI-compatible endpoint. ---
# Leave blank to use only the seed bank + templated generator (no network, no key).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
